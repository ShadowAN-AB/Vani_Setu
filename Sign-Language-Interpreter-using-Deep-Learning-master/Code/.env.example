# Copy this file to .env and fill in values.
#   cp .env.example .env

PORT=5001

# 127.0.0.1 = only this Mac (local demo)
# 0.0.0.0   = required on Render / Railway / any public host
HOST=127.0.0.1

# Login is always email + password, hashed in a local SQLite file (users.db).
# Optional: on Render/Railway set this to the Postgres URL they give you to
# move accounts off the local SQLite file.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
