# Copy this file to .env and fill in values.
#   cp .env.example .env

PORT=5001

# 127.0.0.1 = only this Mac (local demo)
# 0.0.0.0   = required on Render / Railway / any public host
HOST=127.0.0.1

# How people sign in:
#   password = email + password stored in SQLite (default)
#   otp      = email code if SMTP is set, otherwise the terminal (local only)
#   guest    = password/OTP plus a "Continue as guest" button
#   none     = skip the login screen entirely
AUTH_MODE=password

# Optional. If unset, accounts go in Code/users.db (SQLite).
# On Render/Railway set this to the Postgres URL they give you.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Email OTP (only if AUTH_MODE=otp or guest) ---
# 1. Google Account → Security → 2-Step Verification ON
# 2. Security → App passwords → generate one for "Mail"
# 3. Paste the 16-character password as SMTP_PASS (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
